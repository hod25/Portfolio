[Unit]
Description=Hod Mitrany Portfolio Website
After=network.target

[Service]
Type=simple
# Create a dedicated non-root user on the host (e.g. `useradd -r -m portfolio`)
User=portfolio
WorkingDirectory=/srv/portfolio
Environment=NODE_ENV=production
EnvironmentFile=-/etc/portfolio.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
